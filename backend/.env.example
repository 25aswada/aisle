# Local development only. Use deployment-managed credentials in production.
DATABASE_URL=postgresql+psycopg://aisle:aisle_local@localhost:5432/aisle
# Optional. Without a key, search uses the deterministic catalog fallback.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# auto picks Anthropic when its key is set, otherwise OpenAI.
# AISLE_AI_PROVIDER=auto
# Defaults to claude-opus-5-5 (anthropic) or gpt-6-luna (openai).
# AISLE_AI_MODEL=
# Optional. logo.dev publishable key (pk_...) for retailer logos; without it the
# app shows letter tiles.
# LOGO_DEV_PUBLISHABLE_KEY=
# AISLE_AI_STRATEGY=catalog_first
# Seconds to wait for the AI: location guesses, written replies (follow-ups, photos), and
# a search's explanation. A search's guess and explanation together stay under Heroku's
# 30-second limit.
# AISLE_AI_TIMEOUT_SECONDS=8
# AISLE_AI_REPLY_TIMEOUT_SECONDS=22
# AISLE_AI_EXPLAIN_TIMEOUT_SECONDS=16
# With a key, the model also writes each result's explanation; false turns that off.
# AISLE_AI_EXPLAIN=true
# With an OpenAI key, OpenAI's free moderation checks messages and replies; false turns it off.
# AISLE_AI_MODERATION=true
# Signs Aisle's chat replies (any long random string). Required on Heroku; locally a
# fixed development key is used.
# AISLE_CHAT_SIGNING_KEY=

# Accounts. Each sign-in method is turned off until its keys are set.
# SMS codes (Twilio Verify):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Email codes (Resend, from a verified domain):
# RESEND_API_KEY=
# AISLE_EMAIL_FROM=Aisle <codes@shopaisle.app>
# Sign in with Google (iOS OAuth client ID):
# GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple (defaults to app.shopaisle.aisle):
# APPLE_BUNDLE_ID=
# A Sign in with Apple key, so deleting an account revokes its Apple sign-in. The private
# key is the .p8 file's contents (BEGIN/END lines included).
# APPLE_TEAM_ID=ABCDE12345
# APPLE_SIGNIN_KEY_ID=FGHIJ67890
# APPLE_SIGNIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Calling codes (comma separated) SMS codes can go to, and sign-in codes sent per
# channel (sms, email) across everyone.
# AISLE_SMS_COUNTRY_CODES=1
# AISLE_CODES_PER_HOUR=200
# AISLE_CODES_PER_DAY=1000
# Aisle+: accept Xcode's local StoreKit test purchases (development only, never production).
# AISLE_PLUS_ALLOW_XCODE=true
# The free tier's daily limits. Past AI searches, search still works without the AI.
# AISLE_FREE_PHOTO_SEARCHES=3
# AISLE_FREE_FOLLOW_UPS=5
# AISLE_FREE_AI_SEARCHES=20
# AISLE_SIGNED_OUT_AI_SEARCHES=5
# Aisle+ fair use, per day.
# AISLE_PLUS_PHOTO_SEARCHES=50
# AISLE_PLUS_FOLLOW_UPS=100
# AISLE_PLUS_AI_SEARCHES=300
# What everyone's AI use together may cost per day, in US dollars, priced per call from
# the tokens it used. Past it, AI features pause until tomorrow; 0 turns the AI off.
# AISLE_AI_BUDGET_USD_PER_DAY=25
# Fair use, per account (or per network when signed out), per hour.
# AISLE_SEARCHES_PER_HOUR=120
# AISLE_PHOTOS_PER_HOUR=20
# AISLE_FOLLOW_UPS_PER_HOUR=40
# AISLE_ROUTES_PER_HOUR=60
# AISLE_WRITES_PER_HOUR=120
# Per network: sign-ins and code checks an hour, new accounts a day.
# AISLE_SIGN_INS_PER_HOUR=60
# AISLE_NEW_ACCOUNTS_PER_IP_PER_DAY=20
# New store maps one network can cause in a day, and for everyone in a day.
# AISLE_NEW_STORE_MAPS_PER_IP_PER_DAY=150
# AISLE_NEW_STORE_MAPS_PER_DAY=3000

# Logs go to stdout: DEBUG, INFO, WARNING or ERROR.
# AISLE_LOG_LEVEL=INFO
# Error reports to Sentry, off until a DSN is set. The environment defaults to
# production on Heroku and development elsewhere; traces are performance samples (0 to 1).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
