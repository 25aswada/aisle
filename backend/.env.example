# Local development only. Use deployment-managed credentials in production.
DATABASE_URL=postgresql+psycopg://aisle:aisle_local@localhost:5432/aisle
# Optional. Without a key, search uses the deterministic catalog fallback.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# auto picks Anthropic when its key is set, otherwise OpenAI.
# AISLE_AI_PROVIDER=auto
# Defaults to claude-opus-5-5 (anthropic) or gpt-6-luna (openai).
# AISLE_AI_MODEL=
# Optional. logo.dev publishable key (pk_...) for retailer logos; without it the
# app shows letter tiles.
# LOGO_DEV_PUBLISHABLE_KEY=
# AISLE_AI_STRATEGY=catalog_first
# With a key, the model also writes each result's explanation; false turns that off.
# AISLE_AI_EXPLAIN=true

# Accounts. Each sign-in method is turned off until its keys are set.
# SMS codes (Twilio Verify):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Email codes (Resend, from a verified domain):
# RESEND_API_KEY=
# AISLE_EMAIL_FROM=Aisle <codes@shopaisle.app>
# Sign in with Google (iOS OAuth client ID):
# GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple (defaults to app.shopaisle.aisle):
# APPLE_BUNDLE_ID=
