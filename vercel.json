{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 website/build.py",
  "outputDirectory": "website/public",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/join/(.+)",
      "destination": "/join/"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
